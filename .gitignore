node_modules/
package-lock.json
media/
recordings/
clips/

# stream-engine (local operator PC only) — never commit the YouTube
# Stream URL/Key or on-disk recording buffer/retry queue.
stream-engine/config.local.json
stream-engine/retry-queue.local.json
stream-engine/clip-jobs.local.json
stream-engine/buffer/
stream-engine/StreamEngineData/

# Bundled ffmpeg/ffprobe binaries — see stream-engine/bin/README.md.
# Multi-hundred-MB executables never belong in git; each machine (or a
# packaging step) drops the real files in locally.
stream-engine/bin/*.exe
stream-engine/bin/ffmpeg
stream-engine/bin/ffprobe
