### 2. `server.js`
Apni `server.js` file ko khol kar yeh code daal do (isme Socket.io aur Render ka port ka sab set hai):

```javascript
const express = require('express');
const http = require('http');
const { Server } = require('socket.io');

const app = express();
const server = http.createServer(app);
const io = new Server(server);

// Static files serve karne ke liye
app.use(express.static(__dirname));

app.get('/', (req, res) => {
    res.sendFile(__dirname + '/index.html');
});

app.get('/overlay', (req, res) => {
    res.sendFile(__dirname + '/overlay.html');
});

io.on('connection', (socket) => {
    console.log('A user connected');

    socket.on('updateScore', (data) => {
        io.emit('liveScore', data);
    });

    socket.on('disconnect', () => {
        console.log('A user disconnected');
    });
});

// Render ke liye zaroori hai ki yeh process.env.PORT use kare
const PORT = process.env.PORT || 3000;

server.listen(PORT, () => {
    console.log(`Server is running on port ${PORT}`);
});