{
  "name": "clipper-helper",
  "version": "3.0.0",
  "description": "Local vMix clip-cutter (18s: 15s before / 3s after) with decoupled upload queue, validation, and watchdogs for 6-7hr match reliability",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg server.js --targets node18-win-x64 --output ClipperHelper.exe"
  },
  "dependencies": {
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  },
  "pkg": {
    "assets": [
      "node_modules/@ffmpeg-installer/**/*"
    ]
  }
}
